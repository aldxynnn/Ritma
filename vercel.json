{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "true",
  "buildCommand": "bash scripts/vercel_build.sh",
  "outputDirectory": "build/web",
  "headers": [
    {
      "source": "/(index\\.html|flutter_bootstrap\\.js|flutter_service_worker\\.js|version\\.json|manifest\\.json|main\\.dart\\.js|main\\.dart\\.wasm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(assets|icons)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(assets-v|canvaskit)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|assets-v/|canvaskit/|icons/|flutter_bootstrap\\.js|flutter\\.js|flutter_service_worker\\.js|main\\.dart\\.js|main\\.dart\\.wasm|manifest\\.json|favicon\\.png|version\\.json).*)",
      "destination": "/index.html"
    }
  ]
}
