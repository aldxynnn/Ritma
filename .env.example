# RITMA Environment Configuration Template
# Copy to env/dev.json (for --dart-define-from-file=env/dev.json) or pass via --dart-define.
# NEVER commit real API keys, service role keys, or secrets.
#
# Supported environments: dev | staging | prod
APP_ENV=dev
APP_NAME=RITMA

# Supabase public client config (safe for client when RLS is strictly enforced;
# NEVER place SUPABASE_SERVICE_ROLE_KEY in client config)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Observability & Feature Flags
ENABLE_DEBUG_LOGGING=true
ENABLE_DEMO_MODE=false
